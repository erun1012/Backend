rules_version = '2';

// 초안 - 스키마 확정 후 컬렉션별로 구체화할 것 (docs/BACKEND_TASKS.md 대1-3)
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

        // 앱이 직접 쓰면 안 되는 필드 (서버 함수만 변경)
        function serverOnlyKeys() {
          return ['lateCount', 'totalLateMinutes', 'appointmentCount',
                  'friendCode', 'friendCodeChangedAt',
                  'onboardingCompleted', 'notificationEnabled'];
        }

        // 본인 유저 문서만 읽기/수정
        match /users/{uid} {
          allow read: if signedIn();
          allow create: if signedIn() && request.auth.uid == uid
            && !request.resource.data.keys().hasAny(serverOnlyKeys());
          allow update: if signedIn() && request.auth.uid == uid
            && !request.resource.data.diff(resource.data).affectedKeys()
                .hasAny(serverOnlyKeys());
          allow delete: if false;
        }

    // 나머지는 기본 차단 (서버 함수에서만 접근)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
